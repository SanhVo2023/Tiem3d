# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit real keys.
#
#   cp .env.local.example .env.local

# --- Google Gemini ("Nano Banana") -------------------------------------------
# Used only by the scripts/generate-*.mjs image generators, never at runtime.
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Image model. Options this project has verified access to, cheapest first:
#   gemini-3.1-flash-image   (default — newest flash tier)
#   gemini-2.5-flash-image   (previous generation)
#   gemini-3-pro-image       (Pro — best text rendering and detail, costs more)
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# --- Cloudflare R2 -----------------------------------------------------------
# scripts/upload-to-r2.mjs drives Wrangler, which reuses the session from
# `npx wrangler login`. There are deliberately no R2 access keys here: this repo
# leaked long-lived credentials once already, and an OAuth session that lives in
# the CLI's own config cannot be committed by accident.
#
# Only the bucket name is configurable, and it defaults to tiem3d-assets.
R2_BUCKET_NAME=tiem3d-assets

# --- Public CDN --------------------------------------------------------------
# The R2 bucket's public hostname, e.g. https://cdn.tiem3d.com
#
# Read at build time by src/lib/cdn.ts, which rewrites /assets/* image paths
# only. It is NOT wired to next.config's assetPrefix — that would route the
# self-hosted fonts through the CDN too, and they would fail CORS and leave the
# site unstyled. That has already happened once.
#
# Two rules before setting this:
#   1. `npm run cdn:upload` must have pushed the assets to the bucket.
#   2. The hostname must actually serve them. The pub-*.r2.dev URL is rate
#      limited and unsuitable for production — use a custom domain.
#
# Leave blank to serve images from the origin. public/assets ships in the
# deploy either way, so clearing this is a complete rollback.
NEXT_PUBLIC_CDN_URL=

# Optional Google Search Console URL-prefix verification token (HTML tag value).
# Domain verification via DNS does not require this. Rebuild after changing it.
GOOGLE_SITE_VERIFICATION=
