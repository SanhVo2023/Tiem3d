# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Secrets live in .env.local only (covered by the .env* rule above).
# The scripts/ files used to hold hardcoded keys and were ignored to hide them —
# that never worked, because .gitignore has no effect on already-tracked files.
# They now read from process.env and are safe to commit.

# Local screenshots / scratch
.playwright-mcp/
*.local.png
*.local.jpeg

# Contentlayer
.contentlayer
